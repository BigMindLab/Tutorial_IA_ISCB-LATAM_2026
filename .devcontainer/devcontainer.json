{
  "name": "ISCB LATAM 2026 AI workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    },
    "codespaces": {
      "openFiles": ["modules/M02_multiomics_alphagenome/README.md"]
    }
  },
  "secrets": {
    "ALPHA_GENOME_API_KEY": {
      "description": "Your AlphaGenome API key (free for non-commercial use).",
      "documentationUrl": "https://deepmind.google.com/science/alphagenome"
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
